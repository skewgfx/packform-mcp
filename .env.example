# Packform MCP server configuration
#
# Copy to a file OUTSIDE this repository, for example:
#   mkdir -p ~/.config/packform-mcp && chmod 700 ~/.config/packform-mcp
#   cp .env.example ~/.config/packform-mcp/env && chmod 600 ~/.config/packform-mcp/env
#
# Never commit the filled-in version.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PACKFORM_BASE_URL=https://www.packform.com
PACKFORM_MCP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# auto     - try Postgres first, fall back to direct authentication (recommended)
# postgres - only read the token the n8n Access Token Save workflow stores
# direct   - only authenticate with the username and password below
PACKFORM_AUTH_MODE=auto

# --- Option 1: read the token n8n already refreshes -------------------------
# Leave PACKFORM_PG_DSN empty to disable this source.
PACKFORM_PG_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Adjust only if the table or column is named differently. Check with:
#   \d access_token
PACKFORM_TOKEN_TABLE=access_token
PACKFORM_TOKEN_COLUMN=access_token

# Optional. If the table keeps more than one row, name the column to sort by so
# the newest token wins, e.g. created_at or refreshed_at. Leave empty if the
# table only ever holds one row (the n8n workflow deletes before inserting).
PACKFORM_TOKEN_ORDER_BY=

# --- Option 2: authenticate directly ----------------------------------------
# Only used when Postgres yields nothing, or when AUTH_MODE=direct.
PACKFORM_USERNAME=
PACKFORM_PASSWORD=

# How long to reuse a token before fetching it again, in seconds.
PACKFORM_TOKEN_TTL=1800

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Months of quote history to request by default. Packform's own UI uses 3.
PACKFORM_PAST_QUOTE_MONTHS=3

# Reserved. This build implements no write tools; the flag exists so that
# enabling writes later is a deliberate configuration change.
PACKFORM_MCP_ALLOW_WRITES=false
